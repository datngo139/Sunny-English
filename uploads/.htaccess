# Ảnh do admin tải lên. Không cho chạy mã PHP trong thư mục này.
# (Bản tối giản để chạy được trên cả hosting miễn phí lẫn Hostinger.)
<FilesMatch "\.(php|phtml|phar|php[0-9])$">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>
