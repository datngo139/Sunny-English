# ==== Sunny Education — cấu hình Apache/LiteSpeed (Hostinger) ====
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# (Tuỳ chọn) Ép HTTPS: bỏ dấu # ở 2 dòng dưới SAU KHI đã bật SSL cho tên miền trên Hostinger.
#RewriteCond %{HTTPS} !=on [NC]
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Chặn truy cập thư mục/tệp nhạy cảm (mã nguồn, CSDL, .git...). Trả 404 thay vì 403.
RewriteRule ^(app|data|dev|\.git|\.github|\.claude)(/|$) - [R=404,L]
RewriteRule (^|/)\.(?!well-known) - [R=404,L]
RewriteRule \.(sqlite|sqlite-wal|sqlite-shm|log|md|sample\.php)$ - [R=404,L]

# Đường dẫn đẹp
RewriteRule ^bai-viet/?$ blog.php [L,QSA]
RewriteRule ^bai-viet/([a-z0-9-]+)/?$ post.php?slug=$1 [L,QSA]
RewriteRule ^sunny-world/?$ sunny-world.php [L,QSA]
RewriteRule ^sunny-world/(tu-vung|truyen|ba-me)/?$ sunny-world.php?view=$1 [L,QSA]
RewriteRule ^sunny-world/(tu-vung|truyen)/([a-z0-9-]+)/?$ sunny-world.php?view=$1&slug=$2 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

# Header bảo mật cơ bản
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Cache tài nguyên tĩnh (đã có ?v=… nên đổi file là tự tải lại)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /404.php
